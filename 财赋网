<head>
  <meta charset="UTF-8">
  <title>财赋网日报上传</title>
  <style>
    body { font-family: -apple-system, sans-serif; max-width: 500px; margin: 60px auto; padding: 0 24px; color: #1a1a1a; line-height: 1.75; }
    h1 { color: #1e88e5; border-bottom: 3px solid #1e88e5; padding-bottom: 12px; font-size: 24px; }
    .box { background: #f5f7fa; border: 2px dashed #c5d9ed; border-radius: 12px; padding: 40px; text-align: center; margin: 24px 0; }
    input[type=file] { display: none; }
    label { display: inline-block; background: #1e88e5; color: #fff; padding: 14px 32px; border-radius: 8px; cursor: pointer; font-weight: 600; font-size: 16px; }
    label:hover { background: #1565c0; }
    .status { padding: 16px; border-radius: 8px; margin: 16px 0; text-align: center; font-weight: 600; }
    .success { background: #e8f5e9; color: #1b5e20; }
    .error { background: #ffebee; color: #c62828; }
    .loading { background: #fff3e0; color: #e65100; }
    .info { background: #e3f2fd; color: #1565c0; font-size: 14px; padding: 12px; border-radius: 6px; margin: 16px 0; }
  </style>
</head>
<body>
  <h1>📤 财赋网日报上传</h1>

  <div class="info">
    📌 每天导出的 xlsx 文件拖到这里上传<br>
    📌 上传成功后 9 点会自动跑报告
  </div>

  <div class="box">
    <input type="file" id="file" accept=".xlsx,.xls">
    <label for="file">📁 选择文件 / 拖拽文件到这里</label>
    <p style="margin-top:20px;color:#666;font-size:14px;" id="filename">还没选择文件</p>
  </div>

  <div id="status"></div>

  <div style="margin-top:40px;padding:20px;background:#f5f7fa;border-radius:8px;font-size:13px;color:#666;">
    <strong>📌 操作步骤：</strong><br>
    1) 企业微信智能表格 → 右上角 ··· → 导出 xlsx<br>
    2) 上面的"选择文件"按钮选 xlsx<br>
    3) 上传成功 → 等 9 点（或现在跑）<br>
    4) 报告地址：<a href="https://infectious-joint-cab-pale.trycloudflare.com/reports/index.html">查看今日报告</a>
  </div>

<script>
const fileInput = document.getElementById('file');
const status = document.getElementById('status');
const filename = document.getElementById('filename');

fileInput.addEventListener('change', () => {
  if (fileInput.files[0]) {
    filename.textContent = '已选：' + fileInput.files[0].name;
    uploadFile(fileInput.files[0]);
  }
});

['dragover', 'dragenter'].forEach(e =>
  document.querySelector('.box').addEventListener(e, ev => {
    ev.preventDefault();
    ev.stopPropagation();
  })
);

document.querySelector('.box').addEventListener('drop', e => {
  e.preventDefault();
  if (e.dataTransfer.files[0]) {
    fileInput.files = e.dataTransfer.files;
    filename.textContent = '已选：' + e.dataTransfer.files[0].name;
    uploadFile(e.dataTransfer.files[0]);
  }
});

async function uploadFile(file) {
  status.innerHTML = '<div class="status loading">⏳ 上传中...</div>';

  const formData = new FormData();
  formData.append('file', file);

  try {
    const response = await fetch('/api/upload', {
      method: 'POST',
      body: formData
    });

    if (response.ok) {
      const result = await response.json();
      status.innerHTML = '<div class="status success">✅ 上传成功！<br>' +
        (result.run_now ? '已立刻跑报告' : '9 点自动跑报告') + '</div>';
    } else {
      status.innerHTML = '<div class="status error">❌ 上传失败：' + response.status + '</div>';
    }
  } catch (e) {
    status.innerHTML = '<div class="status error">❌ 上传异常：' + e.message + '</div>';
  }
}
</script>
</body>
